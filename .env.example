# Copy to .env and fill in. NEVER commit .env or cookie files.
# Comma-separated Genspark cookie files, PRIMARY FIRST.
# The primary serves everything it can; others take parallel spillover.
COOKIE_FILES=/absolute/path/to/cookie1.txt,/absolute/path/to/cookie2.txt
API_KEY=genspark-local-key
HOST=127.0.0.1
PORT=8000
MAX_CONCURRENT=2
MIN_START_GAP_S=6.0
STARTUP_PROBE=true
